# Use a separate Supabase project for preview. Never point tests at production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Explicit canonical origin; never derive auth redirects from an untrusted Host.
APP_URL=http://localhost:3000
# Enable only after the Google provider is configured and verified in Supabase.
GOOGLE_AUTH_ENABLED=false
